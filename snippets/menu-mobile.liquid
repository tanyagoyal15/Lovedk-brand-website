{%- comment -%}
  LoveDK mobile menu — close (cross) on top, then 3 tabs (top-level items of main-menu,
  e.g. Shop / Mood / Gifting).
  - A tab whose title contains "Mood" renders its children as image cards.
  - Other tabs: childless children → links; children-with-children → accordions.
  Keeps the theme drawer shell (.menu-mobile / .js-menu-mobile) so open/close still works.
{%- endcomment -%}
{%- assign main_menu = settings.menu_link_mobile | default: 'main-menu' -%}
<div class="menu-mobile ldk-mmenu">
  <div class="menu-mobile__overlay"></div>
  <div class="menu-mobile__inner">

    <div class="ldk-mmenu__top">
      <button class="js-menu-mobile ldk-mmenu__close" type="button" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ldk-mmenu__tabs">
      {%- for top in linklists[main_menu].links -%}
        <button type="button" class="ldk-mmenu__tab{% if forloop.first %} is-active{% endif %}" data-ldk-tab="{{ forloop.index }}">{{ top.title }}</button>
      {%- endfor -%}
    </div>

    <div class="ldk-mmenu__panels">
      {%- for top in linklists[main_menu].links -%}
        {%- assign t = top.title | downcase -%}
        {%- assign is_mood = false -%}
        {%- if t contains 'mood' -%}{%- assign is_mood = true -%}{%- endif -%}
        <div class="ldk-mmenu__panel{% if forloop.first %} is-active{% endif %}" data-ldk-panel="{{ forloop.index }}">
          {%- if is_mood -%}
            <div class="ldk-mmenu__grid">
              {%- for child in top.links -%}
                {%- assign coll = child.object -%}
                {%- assign img = coll.metafields.custom.mobile_nav_image.value | default: coll.image -%}
                <a class="ldk-mmcard" href="{{ child.url }}">
                  <span class="ldk-mmcard__img">
                    {%- if img != blank -%}<img src="{{ img | image_url: width: 400 }}" alt="{{ child.title | escape }}" loading="lazy">{%- endif -%}
                  </span>
                  <span class="ldk-mmcard__title">{{ child.title }}</span>
                </a>
              {%- endfor -%}
            </div>
          {%- else -%}
            <ul class="ldk-mmlist">
              {%- for child in top.links -%}
                {%- if child.links != blank -%}
                  <li class="ldk-mmacc">
                    <button type="button" class="ldk-mmacc__head">{{ child.title }}<i class="feather-chevron-down"></i></button>
                    <ul class="ldk-mmacc__body">
                      {%- for sub in child.links -%}
                        <li><a href="{{ sub.url }}">{{ sub.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </li>
                {%- else -%}
                  <li><a class="ldk-mmlist__link" href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    // Delegated so it works for every .ldk-mmenu instance (theme renders several).
    document.addEventListener('click', function (e) {
      var tab = e.target.closest('.ldk-mmenu__tab');
      if (tab) {
        e.preventDefault();
        e.stopPropagation();
        var root = tab.closest('.ldk-mmenu');
        var idx = tab.getAttribute('data-ldk-tab');
        root.querySelectorAll('.ldk-mmenu__tab').forEach(function (t) { t.classList.toggle('is-active', t === tab); });
        root.querySelectorAll('.ldk-mmenu__panel').forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-ldk-panel') === idx);
        });
        return;
      }
      var head = e.target.closest('.ldk-mmacc__head');
      if (head) {
        e.preventDefault();
        e.stopPropagation();
        head.parentNode.classList.toggle('is-open');
      }
    });
  })();
</script>
