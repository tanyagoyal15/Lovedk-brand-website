      Loading more products...
    </div>
  </div>
</collection-template-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionTemplate{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.collectionHandle = this.dataset.collectionHandle;
        this.currentPage = 1;
        this.isLoading = false;
        this.hasMoreProducts = true;
        this.allProducts = [];
        this.filteredProducts = [];
        this.sortBy = '';
        this.availabilityFilter = [];
        this.priceMin = null;
        this.priceMax = null;
      }

      connectedCallback() {
        this.filterToggle = this.querySelector('[data-filter-toggle]');
        this.sidebar = this.querySelector('[data-filter-sidebar]');
        this.overlay = this.querySelector('[data-sidebar-overlay]');
        this.sidebarClose = this.querySelector('[data-sidebar-close]');
        this.productsGrid = this.querySelector('[data-products-grid]');
        this.loadingIndicator = this.querySelector('[data-loading]');
        this.resetButton = this.querySelector('[data-reset-filters]');
        this.applyButton = this.querySelector('[data-apply-filters]');

        this.setupEventListeners();
        this.loadProducts();
        this.setupInfiniteScroll();
      }

      setupEventListeners() {
        this.filterToggle.addEventListener('click', () => this.openSidebar());
        this.sidebarClose.addEventListener('click', () => this.closeSidebar());
        this.overlay.addEventListener('click', () => this.closeSidebar());
        this.resetButton.addEventListener('click', () => this.resetFilters());
        this.applyButton.addEventListener('click', () => this.applyFilters());
      }

      openSidebar() {
        this.sidebar.classList.add('active');
        this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeSidebar() {
        this.sidebar.classList.remove('active');
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      resetFilters() {
        this.querySelectorAll('input[type="radio"]').forEach(input => input.checked = false);
        this.querySelectorAll('input[type="checkbox"]').forEach(input => input.checked = false);
        this.querySelector('[data-price-min]').value = '';
        this.querySelector('[data-price-max]').value = '';
        this.sortBy = '';
        this.availabilityFilter = [];
        this.priceMin = null;
        this.priceMax = null;
        this.applyFilters();
      }

      applyFilters() {
        const sortInput = this.querySelector('input[name="sort-{{ ai_gen_id }}"]:checked');
        this.sortBy = sortInput ? sortInput.value : '';

        this.availabilityFilter = [];
        if (this.querySelector('#in-stock-{{ ai_gen_id }}').checked) {
          this.availabilityFilter.push('in-stock');
        }
        if (this.querySelector('#out-stock-{{ ai_gen_id }}').checked) {
          this.availabilityFilter.push('out-stock');
        }

        this.priceMin = parseFloat(this.querySelector('[data-price-min]').value) || null;
        this.priceMax = parseFloat(this.querySelector('[data-price-max]').value) || null;

        this.filterAndSortProducts();
        this.closeSidebar();
      }

      filterAndSortProducts() {
        this.filteredProducts = this.allProducts.filter(product => {
          if (this.availabilityFilter.length > 0) {
            const isAvailable = product.available;
            const matchesFilter = 
              (this.availabilityFilter.includes('in-stock') && isAvailable) ||
              (this.availabilityFilter.includes('out-stock') && !isAvailable);
            if (!matchesFilter) return false;
          }

          if (this.priceMin !== null || this.priceMax !== null) {
            const minPrice = Math.min(...product.variants.map(v => parseFloat(v.price)));
            if (this.priceMin !== null && minPrice < this.priceMin) return false;
            if (this.priceMax !== null && minPrice > this.priceMax) return false;
          }

          return true;
        });

        if (this.sortBy) {
          this.filteredProducts.sort((a, b) => {
            switch (this.sortBy) {
              case 'title-asc':
                return a.title.localeCompare(b.title);
              case 'title-desc':
                return b.title.localeCompare(a.title);
              case 'price-asc':
                const aMinPrice = Math.min(...a.variants.map(v => parseFloat(v.price)));
                const bMinPrice = Math.min(...b.variants.map(v => parseFloat(v.price)));
                return aMinPrice - bMinPrice;
              case 'price-desc':
                const aMaxPrice = Math.min(...a.variants.map(v => parseFloat(v.price)));
                const bMaxPrice = Math.min(...b.variants.map(v => parseFloat(v.price)));
                return bMaxPrice - aMaxPrice;
              case 'created-asc':
                return new Date(a.created_at) - new Date(b.created_at);
              case 'created-desc':
                return new Date(b.created_at) - new Date(a.created_at);
              default:
                return 0;
            }
          });
        }

        this.renderProducts();
      }

      async loadProducts() {
        if (this.isLoading || !this.hasMoreProducts) return;

        this.isLoading = true;
        this.loadingIndicator.classList.add('active');

        try {
          const response = await fetch(
            `/collections/${this.collectionHandle}/products.json?page=${this.currentPage}&limit=250`
          );
          const data = await response.json();

          if (data.products && data.products.length > 0) {
            this.allProducts = this.allProducts.concat(data.products);
            this.currentPage++;
            
            if (data.products.length < 250) {
              this.hasMoreProducts = false;
            }
          } else {
            this.hasMoreProducts = false;
          }

          this.filteredProducts = [...this.allProducts];
          this.renderProducts();
        } catch (error) {
          console.error('Error loading products:', error);
        } finally {
          this.isLoading = false;
          this.loadingIndicator.classList.remove('active');
        }
      }

      renderProducts() {
        this.productsGrid.innerHTML = '';

        this.filteredProducts.forEach(product => {
          const productCard = this.createProductCard(product);
          this.productsGrid.appendChild(productCard);
        });
      }

      createProductCard(product) {
        const card = document.createElement('div');
        card.className = 'ai-product-card-{{ ai_gen_id }}';

        const imageUrl = product.images[0] ? product.images[0].src : '';
        const productUrl = `/products/${product.handle}`;
        
        const minPrice = Math.min(...product.variants.map(v => parseFloat(v.price)));
        const minComparePrice = Math.min(...product.variants.map(v => parseFloat(v.compare_at_price || v.price)));
        
        const hasDiscount = minComparePrice > minPrice;

        const priceHTML = hasDiscount
          ? `<span class="ai-price-compare-{{ ai_gen_id }}">₹${minComparePrice.toFixed(2)}</span><span class="ai-price-sale-{{ ai_gen_id }}">₹${minPrice.toFixed(2)}</span>`
          : `<span>₹${minPrice.toFixed(2)}</span>`;

        card.innerHTML = `
          <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
            ${imageUrl ? `<img src="${imageUrl}" alt="${product.title}" class="ai-product-image-{{ ai_gen_id }}" loading="lazy">` : ''}
            <div class="ai-product-actions-{{ ai_gen_id }}">
              <button class="ai-product-action-btn-{{ ai_gen_id }}" data-wishlist data-product-id="${product.id}" aria-label="Add to wishlist">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
              <button class="ai-product-action-btn-{{ ai_gen_id }}" data-add-to-cart data-variant-id="${product.variants[0].id}" aria-label="Add to cart">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="ai-product-info-{{ ai_gen_id }}">
            <div class="ai-product-name-{{ ai_gen_id }}">${product.title}</div>
            <div class="ai-product-price-{{ ai_gen_id }}">${priceHTML}</div>
            <a href="${productUrl}" class="ai-view-product-btn-{{ ai_gen_id }}">View Product</a>
          </div>
        `;

        const wishlistBtn = card.querySelector('[data-wishlist]');
        const cartBtn = card.querySelector('[data-add-to-cart]');

        wishlistBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.toggleWishlist(product.id, wishlistBtn);
        });

        cartBtn.addEventListener('click', (e) => {
          e.preventDefault();
          this.addToCart(product.variants[0].id, cartBtn);
        });

        return card;
      }

      toggleWishlist(productId, button) {
        let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        const index = wishlist.indexOf(productId);

        if (index > -1) {
          wishlist.splice(index, 1);
          button.classList.remove('active');
        } else {
          wishlist.push(productId);
          button.classList.add('active');
        }

        localStorage.setItem('wishlist', JSON.stringify(wishlist));
        this.updateWishlistCount();
      }

      updateWishlistCount() {
        const wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        const event = new CustomEvent('wishlist:updated', { detail: { count: wishlist.length } });
        document.dispatchEvent(event);
      }

      async addToCart(variantId, button) {
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: variantId,
              quantity: 1
            })
          });

          if (response.ok) {
            button.classList.add('active');
            setTimeout(() => button.classList.remove('active'), 1000);
            
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
        }
      }

      setupInfiniteScroll() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !this.isLoading && this.hasMoreProducts) {
              this.loadProducts();
            }
          });
        }, {
          rootMargin: '200px'
        });

        observer.observe(this.loadingIndicator);
      }
    }

    customElements.define('collection-template-{{ ai_gen_id }}', CollectionTemplate{{ ai_gen_id }});
  })();
</script>

