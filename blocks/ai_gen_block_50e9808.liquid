{% doc %}
  @prompt
    Recreate a responsive "Shop by Category" section featuring six perfectly circular product images with centered text labels underneath each one (e.g., "Necklace", "Bracelet", "Earring", anklet, waist chain, rings) in a serif New York font. On desktop, all six circles should be displayed in a single horizontal row. For mobile and tablet views, the section must become a touch-friendly slider that shows exactly three circles at a time to prevent overcrowding; crucially, add two visible, minimalist arrow icons (chevron style) on the far left and right sides of the slider so users know they can scroll. The images should have a clean, high-resolution appearance with no borders, and the text below should be perfectly aligned with the center of each circle. Ensure the entire element (circle + text) is clickable and points to its respective collection. The background should be a solid, clean white with consistent top and bottom padding, maintaining a professional and elegant aesthetic that matches the "New York" typography used throughout the site. Each circle thing is also like a link to a collection they can open. And also I can set the image that is present in the circle. ,, Okay, right now the arrow buttons are actually coming on top of, hiding, and overlapping the three collections that are seen in the phone view. What you're supposed to do is in the phone view, you're supposed to make the arrows (the left and right arrows) in such a way that those three collections should appear in a little centre, and the arrow should be towards left and right. , Photos are way too small. You need to make the photos considerably bigger. Give me an option to make the photos bigger or smaller.
    
    Also, the left and right arrows are taking up a lot of space, so make sure they are not taking as much space as they are right now. , Dude, you need to make the images way, way bigger. , MAKE THE IMAGES BIGGER. AND I MEAN WAY WAY BIGGER. YOU NEED TO STYOP LOOKINGA TALL OF THET SHIT AND JSUT MAKE IT BIGGER, Perfect, the image sizes are absolutely fine. There is nothing to worry about right now. Forget about what I said about the three images should appear in the centre and all. Just make the arrows appear on top of the thing. That's absolutely fine, just do that. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-category-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-shop-category-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-category-desktop-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-shop-category-mobile-{{ ai_gen_id }} {
    display: none;
    position: relative;
  }

  .ai-shop-category-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-shop-category-slider-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, {{ block.settings.mobile_image_size }}px);
    gap: {{ block.settings.mobile_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px;
  }

  .ai-shop-category-slider-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-shop-category-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
    width: {{ block.settings.mobile_image_size }}px;
  }

  .ai-shop-category-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: {{ block.settings.text_spacing }}px;
  }

  .ai-shop-category-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-shop-category-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family }}, serif;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0;
  }

  .ai-shop-category-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: calc({{ block.settings.mobile_image_size }}px / 2);
    transform: translateY(-50%);
    background-color: {{ block.settings.arrow_background }};
    border: 1px solid {{ block.settings.arrow_border_color }};
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    z-index: 10;
  }

  .ai-shop-category-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
  }

  .ai-shop-category-arrow-left-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-shop-category-arrow-right-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-shop-category-arrow-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.arrow_size }}px * 0.5);
    height: calc({{ block.settings.arrow_size }}px * 0.5);
    stroke: {{ block.settings.arrow_color }};
  }

  @media screen and (max-width: 1024px) {
    .ai-shop-category-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-shop-category-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }
{% endstyle %}

<shop-by-category-{{ ai_gen_id }} class="ai-shop-category-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-category-container-{{ ai_gen_id }}">
    <div class="ai-shop-category-desktop-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign label_key = 'label_' | append: i
          assign image_key = 'image_' | append: i
          
          assign collection = block.settings[collection_key]
          assign label = block.settings[label_key]
          assign image = block.settings[image_key]
        %}
        
        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-shop-category-item-{{ ai_gen_id }}">
            <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
              {% if image != blank %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ label | escape }}"
                  class="ai-shop-category-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% elsif collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 600 }}"
                  alt="{{ label | escape }}"
                  class="ai-shop-category-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-shop-category-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if label != blank %}
              <p class="ai-shop-category-label-{{ ai_gen_id }}">{{ label }}</p>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-shop-category-mobile-{{ ai_gen_id }}">
      <div class="ai-shop-category-slider-wrapper-{{ ai_gen_id }}">
        <button class="ai-shop-category-arrow-{{ ai_gen_id }} ai-shop-category-arrow-left-{{ ai_gen_id }}" aria-label="Previous categories">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <div class="ai-shop-category-slider-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% liquid
              assign collection_key = 'collection_' | append: i
              assign label_key = 'label_' | append: i
              assign image_key = 'image_' | append: i
              
              assign collection = block.settings[collection_key]
              assign label = block.settings[label_key]
              assign image = block.settings[image_key]
            %}
            
            {% if collection != blank %}
              <a href="{{ collection.url }}" class="ai-shop-category-item-{{ ai_gen_id }}">
                <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
                  {% if image != blank %}
                    <img
                      src="{{ image | image_url: width: 600 }}"
                      alt="{{ label | escape }}"
                      class="ai-shop-category-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% elsif collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 600 }}"
                      alt="{{ label | escape }}"
                      class="ai-shop-category-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-shop-category-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                {% if label != blank %}
                  <p class="ai-shop-category-label-{{ ai_gen_id }}">{{ label }}</p>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        <button class="ai-shop-category-arrow-{{ ai_gen_id }} ai-shop-category-arrow-right-{{ ai_gen_id }}" aria-label="Next categories">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</shop-by-category-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByCategory{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.slider = this.querySelector('.ai-shop-category-slider-{{ ai_gen_id }}');
        this.leftArrow = this.querySelector('.ai-shop-category-arrow-left-{{ ai_gen_id }}');
        this.rightArrow = this.querySelector('.ai-shop-category-arrow-right-{{ ai_gen_id }}');

        if (this.slider && this.leftArrow && this.rightArrow) {
          this.setupEventListeners();
          this.updateArrowVisibility();
        }
      }

      setupEventListeners() {
        this.leftArrow.addEventListener('click', () => this.scroll('left'));
        this.rightArrow.addEventListener('click', () => this.scroll('right'));
        this.slider.addEventListener('scroll', () => this.updateArrowVisibility());
      }

      scroll(direction) {
        const itemWidth = {{ block.settings.mobile_image_size }};
        const gap = {{ block.settings.mobile_gap }};
        const scrollAmount = (itemWidth + gap) * 3;

        if (direction === 'left') {
          this.slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          this.slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      updateArrowVisibility() {
        const isAtStart = this.slider.scrollLeft <= 0;
        const isAtEnd = this.slider.scrollLeft + this.slider.clientWidth >= this.slider.scrollWidth - 1;

        this.leftArrow.style.opacity = isAtStart ? '0.3' : '1';
        this.leftArrow.style.pointerEvents = isAtStart ? 'none' : 'auto';
        
        this.rightArrow.style.opacity = isAtEnd ? '0.3' : '1';
        this.rightArrow.style.pointerEvents = isAtEnd ? 'none' : 'auto';
      }
    }

    customElements.define('shop-by-category-{{ ai_gen_id }}', ShopByCategory{{ ai_gen_id }});
  })();
</script>

