  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Badge images"
    },
    {
      "type": "paragraph",
      "content": "Upload 5 trust badge images. The badges will scroll continuously in a loop."
    },
    {
      "type": "image_picker",
      "id": "badge_1",
      "label": "Badge 1"
    },
    {
      "type": "image_picker",
      "id": "badge_2",
      "label": "Badge 2"
    },
    {
      "type": "image_picker",
      "id": "badge_3",
      "label": "Badge 3"
    },
    {
      "type": "image_picker",
      "id": "badge_4",
      "label": "Badge 4"
    },
    {
      "type": "image_picker",
      "id": "badge_5",
      "label": "Badge 5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
