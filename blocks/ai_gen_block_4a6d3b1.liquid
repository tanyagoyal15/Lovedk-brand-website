{% doc %}
  @prompt
    Add auto-scrolling carousel functionality to an existing "featured-custom-section" section that contains a "collection-image" block with 8 image blocks. The carousel should:
    - Automatically loop and scroll through all images continuously
    - Work on mobile (currently only 2 images show, need to be able to scroll through all 8)
    - Show 2 images on mobile and 4 on desktop, but allow swiping/scrolling through the rest
    - Have infinite loop / auto-play enabled by default
    - Be touch-friendly for mobile swipe gestures
    - Not break the existing layout or image styling, below each image i can also add a text. also adda. title over all these called "SHOP BY MOOD" - make sure its capitalized, italics adn in pink. also all teh pictures that i upload they have to be the same size. iamge 1 and image 2 can vary in size when i upload but oyu need to make sure that htey are showni in teh same zize, there are only 4 things. and also remove the left adn rigth controls. make the autoscrolling slower, the phtoos bigger adn also add some padding above shop by mood . also the photos has to be longer. also add some css to teh text i am adding belwo the images. also each iamge/text is clickable adn it goes to ta. collection page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
    padding-top: {{ block.settings.top_padding }}px;
  }

  .ai-carousel-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin-bottom: 40px;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: 1px;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.8s ease;
    will-change: transform;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.desktop_columns | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.desktop_columns }});
    min-width: 0;
  }

  .ai-carousel-slide-link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 15px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-carousel-slide-link-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-carousel-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-carousel-slide-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-carousel-slide-link-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-carousel-slide-text-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    font-weight: {{ block.settings.text_weight }};
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
    transition: color 0.3s ease;
  }

  .ai-carousel-slide-link-{{ ai_gen_id }}:hover .ai-carousel-slide-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
  }

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.3);
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.gap }}px) / 2);
    }

    .ai-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
      margin-bottom: 25px;
    }

    .ai-carousel-slide-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }

    .ai-carousel-{{ ai_gen_id }} {
      padding-top: {{ block.settings.top_padding | times: 0.6 }}px;
    }
  }
{% endstyle %}

<auto-carousel-{{ ai_gen_id }}
  class="ai-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  data-infinite="{{ block.settings.infinite_loop }}"
  data-desktop-columns="{{ block.settings.desktop_columns }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <h2 class="ai-carousel-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-carousel-track-{{ ai_gen_id }}">
    {% if block.settings.image_1 %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}">
        <a href="{{ block.settings.link_1 }}" class="ai-carousel-slide-link-{{ ai_gen_id }}">
          <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_1 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_1.alt | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          </div>
          {% if block.settings.text_1 != blank %}
            <div class="ai-carousel-slide-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
          {% endif %}
        </a>
      </div>
    {% endif %}

    {% if block.settings.image_2 %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}">
        <a href="{{ block.settings.link_2 }}" class="ai-carousel-slide-link-{{ ai_gen_id }}">
          <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_2 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_2.alt | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          </div>
          {% if block.settings.text_2 != blank %}
            <div class="ai-carousel-slide-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
          {% endif %}
        </a>
      </div>
    {% endif %}

    {% if block.settings.image_3 %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}">
        <a href="{{ block.settings.link_3 }}" class="ai-carousel-slide-link-{{ ai_gen_id }}">
          <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_3 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_3.alt | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          </div>
          {% if block.settings.text_3 != blank %}
            <div class="ai-carousel-slide-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</div>
          {% endif %}
        </a>
      </div>
    {% endif %}

    {% if block.settings.image_4 %}
      <div class="ai-carousel-slide-{{ ai_gen_id }}">
        <a href="{{ block.settings.link_4 }}" class="ai-carousel-slide-link-{{ ai_gen_id }}">
          <div class="ai-carousel-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.image_4 | image_url: width: 1000 }}"
              alt="{{ block.settings.image_4.alt | escape }}"
              loading="lazy"
              width="1000"
              height="1000"
            >
          </div>
          {% if block.settings.text_4 != blank %}
            <div class="ai-carousel-slide-text-{{ ai_gen_id }}">{{ block.settings.text_4 }}</div>
          {% endif %}
        </a>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_dots %}
    <div class="ai-carousel-controls-{{ ai_gen_id }}">
      <div class="ai-carousel-dots-{{ ai_gen_id }}"></div>
    </div>
  {% endif %}
</auto-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class AutoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.isDragging = false;
        this.startPos = 0;
        this.currentTranslate = 0;
        this.prevTranslate = 0;
        this.animationID = 0;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-carousel-track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');

        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;
        this.infinite = this.dataset.infinite === 'true';
        this.desktopColumns = parseInt(this.dataset.desktopColumns) || 4;
        this.mobileColumns = 2;

        if (this.slides.length === 0) return;

        this.setupInfiniteLoop();
        this.setupTouchEvents();
        this.updateCarousel();

        if (this.dotsContainer) {
          this.createDots();
        }

        if (this.autoplay) {
          this.startAutoplay();
        }

        window.addEventListener('resize', () => this.updateCarousel());
      }

      setupInfiniteLoop() {
        if (!this.infinite || this.slides.length === 0) return;

        const slidesToClone = this.getCurrentColumns();
        
        for (let i = 0; i < slidesToClone; i++) {
          const firstClone = this.slides[i].cloneNode(true);
          const lastClone = this.slides[this.slides.length - 1 - i].cloneNode(true);
          
          this.track.appendChild(firstClone);
          this.track.insertBefore(lastClone, this.track.firstChild);
        }

        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.currentIndex = slidesToClone;
        this.updateCarousel(false);
      }

      getCurrentColumns() {
        return window.innerWidth <= 749 ? this.mobileColumns : this.desktopColumns;
      }

      createDots() {
        const columns = this.getCurrentColumns();
        const totalSlides = this.infinite ? 
          this.slides.length - (columns * 2) : 
          this.slides.length;
        const totalDots = Math.ceil(totalSlides / columns);

        this.dotsContainer.innerHTML = '';

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }

        this.updateDots();
      }

      updateDots() {
        if (!this.dotsContainer) return;

        const dots = this.dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        const columns = this.getCurrentColumns();
        const activeIndex = this.infinite ? 
          Math.floor((this.currentIndex - columns) / columns) : 
          Math.floor(this.currentIndex / columns);

        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === activeIndex);
        });
      }

      setupTouchEvents() {
        this.track.addEventListener('touchstart', (e) => this.touchStart(e));
        this.track.addEventListener('touchmove', (e) => this.touchMove(e));
        this.track.addEventListener('touchend', () => this.touchEnd());

        this.track.addEventListener('mousedown', (e) => this.touchStart(e));
        this.track.addEventListener('mousemove', (e) => this.touchMove(e));
        this.track.addEventListener('mouseup', () => this.touchEnd());
        this.track.addEventListener('mouseleave', () => this.touchEnd());

        this.slides.forEach(slide => {
          slide.addEventListener('dragstart', (e) => e.preventDefault());
        });
      }

      touchStart(event) {
        this.isDragging = true;
        this.startPos = this.getPositionX(event);
        this.animationID = requestAnimationFrame(() => this.animation());
        this.track.style.cursor = 'grabbing';
        this.stopAutoplay();
      }

      touchMove(event) {
        if (this.isDragging) {
          const currentPosition = this.getPositionX(event);
          this.currentTranslate = this.prevTranslate + currentPosition - this.startPos;
        }
      }

      touchEnd() {
        this.isDragging = false;
        cancelAnimationFrame(this.animationID);

        const movedBy = this.currentTranslate - this.prevTranslate;

        if (movedBy < -50) {
          this.next();
        } else if (movedBy > 50) {
          this.prev();
        } else {
          this.updateCarousel();
        }

        this.track.style.cursor = 'grab';

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      getPositionX(event) {
        return event.type.includes('mouse') ? event.pageX : event.touches[0].clientX;
      }

      animation() {
        if (this.isDragging) {
          this.track.style.transform = `translateX(${this.currentTranslate}px)`;
          requestAnimationFrame(() => this.animation());
        }
      }

      next() {
        const columns = this.getCurrentColumns();
        this.currentIndex += columns;
        this.updateCarousel();
      }

      prev() {
        const columns = this.getCurrentColumns();
        this.currentIndex -= columns;
        this.updateCarousel();
      }

      goToSlide(index) {
        const columns = this.getCurrentColumns();
        this.currentIndex = this.infinite ? 
          (index * columns) + columns : 
          index * columns;
        this.updateCarousel();
        this.stopAutoplay();
        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      updateCarousel(animate = true) {
        const columns = this.getCurrentColumns();
        const slideWidth = this.slides[0].offsetWidth;
        const gap = parseInt(getComputedStyle(this.track).gap) || 0;
        const offset = -(this.currentIndex * (slideWidth + gap));

        if (!animate) {
          this.track.style.transition = 'none';
        } else {
          this.track.style.transition = 'transform 0.8s ease';
        }

        this.track.style.transform = `translateX(${offset}px)`;
        this.prevTranslate = offset;
        this.currentTranslate = offset;

        if (this.infinite) {
          this.track.addEventListener('transitionend', () => this.checkInfiniteLoop(), { once: true });
        }

        this.updateDots();
      }

      checkInfiniteLoop() {
        const columns = this.getCurrentColumns();
        const totalSlides = this.slides.length;

        if (this.currentIndex >= totalSlides - columns) {
          this.track.style.transition = 'none';
          this.currentIndex = columns;
          this.updateCarousel(false);
        } else if (this.currentIndex < columns) {
          this.track.style.transition = 'none';
          this.currentIndex = totalSlides - (columns * 2);
          this.updateCarousel(false);
        }
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', () => this.updateCarousel());
      }
    }

    customElements.define('auto-carousel-{{ ai_gen_id }}', AutoCarousel{{ ai_gen_id }});
  })();
</script>

