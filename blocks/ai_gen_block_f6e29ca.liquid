{% doc %}
  @prompt
    Create a customizable icons feature section with the following layout and features:
    
    Layout: A grid displaying feature blocks, each containing an icon, heading, and description text. The section should support multiple feature blocks (at least 5-6).
    
    Design elements from reference:
    - Clean, minimal line-art style icons at the top of each block
    - Bold heading below each icon
    - Descriptive text or tagline below the heading
    - Centered alignment for all content
    - Responsive grid that adapts to mobile (1 column) and desktop (3 columns)
    
    Customization options needed:
    - Section-level settings: background color, padding, heading for the entire section
    - Per-block settings: upload custom icon image, heading text, description text, text alignment
    - Ability to add, remove, and reorder blocks
    - Typography controls for headings and body text
    - Spacing controls between elements
    
    The section should be flexible enough to showcase brand values, features, or benefits with custom icons and messaging.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-features-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-features-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.section_heading_alignment }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.section_heading_size }}px;
    color: {{ block.settings.section_heading_color }};
    font-weight: 600;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment }};
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-feature-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    color: #999;
    white-space: nowrap;
    text-align: center;
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing_item }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-features-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 20px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-features-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.5 }}px 15px {{ block.settings.padding_bottom | times: 0.5 }}px;
    }

    .ai-features-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_heading_size | times: 0.8 }}px;
    }

    .ai-feature-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-feature-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-feature-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<feature-icons-{{ ai_gen_id }} class="ai-features-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-features-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <ul class="ai-features-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign heading_key = 'heading_' | append: i
          assign description_key = 'description_' | append: i
          assign show_key = 'show_feature_' | append: i

          assign icon = block.settings[icon_key]
          assign heading = block.settings[heading_key]
          assign description = block.settings[description_key]
          assign show_feature = block.settings[show_key]
        %}

        {% if show_feature %}
          <li class="ai-feature-item-{{ ai_gen_id }}">
            <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
              {% if icon != blank %}
                <img
                  src="{{ icon | image_url: width: 200 }}"
                  alt="{{ heading | escape }}"
                  class="ai-feature-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-feature-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-feature-empty-state-{{ ai_gen_id }}">Add icon</div>
                </div>
              {% endif %}
            </div>

            {% if heading != blank %}
              <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}

            {% if description != blank %}
              <div class="ai-feature-description-{{ ai_gen_id }}">{{ description }}</div>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</feature-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeFeatures();
      }

      initializeFeatures() {
        const items = this.querySelectorAll('.ai-feature-item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('feature-icons-{{ ai_gen_id }}', FeatureIcons{{ ai_gen_id }});
  })();
</script>

