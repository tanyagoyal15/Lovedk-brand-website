    make a header section. i shoud be able ot uplaod a poto or a video. 
    also the header section as in the slideshopw that appears in the very start of teh website.
    and also i should be able to edit a lot of settings. the video if uuploaded should autoplay as well.
    change so that it shows different photos on different decvices so when i am on dektop, it will show a different phtoo adn when i am on phone it will show a differne tphotot
    4 media slots: desktop photo, desktop video (overrides desktop photo), mobile photo, mobile video (overrides mobile photo)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slideshow-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    height: {{ block.settings.height_desktop }}px;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }
  }

  .ai-hero-slideshow__media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.media_fit }};
  }

  .ai-hero-slideshow__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.media_fit }};
  }

  /* Desktop: show desktop media, hide mobile media */
  .ai-hero-desktop-{{ ai_gen_id }} {
    display: block;
  }
  .ai-hero-mobile-{{ ai_gen_id }} {
    display: none;
  }

  /* Mobile: show mobile media, hide desktop media */
  @media screen and (max-width: 749px) {
    .ai-hero-desktop-{{ ai_gen_id }} {
      display: none;
    }
    .ai-hero-mobile-{{ ai_gen_id }} {
      display: block;
    }
  }

  .ai-hero-slideshow__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    height: 100%;
    padding: {{ block.settings.content_padding_desktop }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
    }
  }

  .ai-hero-slideshow__content-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-hero-slideshow__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size_desktop }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 {{ block.settings.subtitle_spacing }}px 0;
    font-weight: {{ block.settings.subtitle_weight }};
    letter-spacing: {{ block.settings.subtitle_letter_spacing }}px;
    text-transform: {{ block.settings.subtitle_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
    }
  }

  .ai-hero-slideshow__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_desktop }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: {{ block.settings.title_weight }};
    line-height: {{ block.settings.title_line_height }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }
  }

  .ai-hero-slideshow__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_desktop }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    font-weight: {{ block.settings.description_weight }};
    line-height: {{ block.settings.description_line_height }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    text-transform: {{ block.settings.button_text_transform }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
  }

  .ai-hero-slideshow__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-slideshow__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-hero-slideshow__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }
{% endstyle %}

<hero-slideshow-{{ ai_gen_id }}
  class="ai-hero-slideshow-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  {% comment %} ============ DESKTOP MEDIA ============ {% endcomment %}

  {% if block.settings.video_desktop != blank %}
    {%- comment %} Desktop Video {% endcomment -%}
    <video
      class="ai-hero-slideshow__video-{{ ai_gen_id }} ai-hero-desktop-{{ ai_gen_id }}"
      {% if block.settings.video_autoplay %}autoplay{% endif %}
      {% if block.settings.video_loop %}loop{% endif %}
      {% if block.settings.video_muted %}muted{% endif %}
      {% if block.settings.video_controls %}controls{% endif %}
      playsinline
      {% if block.settings.video_desktop_poster %}
        poster="{{ block.settings.video_desktop_poster | image_url: width: 2000 }}"
      {% endif %}
    >
      {% for source in block.settings.video_desktop.sources %}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {% endfor %}
    </video>
  {% elsif block.settings.image_desktop != blank %}
    {%- comment %} Desktop Image {% endcomment -%}
    <img
      src="{{ block.settings.image_desktop | image_url: width: 2500 }}"
      alt="{{ block.settings.image_desktop.alt | escape }}"
      class="ai-hero-slideshow__media-{{ ai_gen_id }} ai-hero-desktop-{{ ai_gen_id }}"
      loading="eager"
      width="{{ block.settings.image_desktop.width }}"
      height="{{ block.settings.image_desktop.height }}"
    >
  {% else %}
    <div class="ai-hero-slideshow__placeholder-{{ ai_gen_id }} ai-hero-desktop-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
      <div class="ai-hero-slideshow__empty-state-{{ ai_gen_id }}">
        Add a desktop image or video to get started
      </div>
    </div>
  {% endif %}

  {% comment %} ============ MOBILE MEDIA ============ {% endcomment %}

  {% if block.settings.video_mobile != blank %}
    {%- comment %} Mobile Video {% endcomment -%}
    <video
      class="ai-hero-slideshow__video-{{ ai_gen_id }} ai-hero-mobile-{{ ai_gen_id }}"
      {% if block.settings.video_autoplay %}autoplay{% endif %}
      {% if block.settings.video_loop %}loop{% endif %}
      {% if block.settings.video_muted %}muted{% endif %}
      {% if block.settings.video_controls %}controls{% endif %}
      playsinline
      {% if block.settings.video_mobile_poster %}
        poster="{{ block.settings.video_mobile_poster | image_url: width: 1000 }}"
      {% endif %}
    >
      {% for source in block.settings.video_mobile.sources %}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {% endfor %}
    </video>
  {% elsif block.settings.image_mobile != blank %}
    {%- comment %} Mobile Image {% endcomment -%}
    <img
      src="{{ block.settings.image_mobile | image_url: width: 1000 }}"
      alt="{{ block.settings.image_mobile.alt | escape }}"
      class="ai-hero-slideshow__media-{{ ai_gen_id }} ai-hero-mobile-{{ ai_gen_id }}"
      loading="eager"
      width="{{ block.settings.image_mobile.width }}"
      height="{{ block.settings.image_mobile.height }}"
    >
  {% elsif block.settings.image_desktop != blank %}
    {%- comment %} Mobile fallback: use desktop image if no mobile image set {% endcomment -%}
    <img
      src="{{ block.settings.image_desktop | image_url: width: 1000 }}"
      alt="{{ block.settings.image_desktop.alt | escape }}"
      class="ai-hero-slideshow__media-{{ ai_gen_id }} ai-hero-mobile-{{ ai_gen_id }}"
      loading="eager"
      width="{{ block.settings.image_desktop.width }}"
      height="{{ block.settings.image_desktop.height }}"
    >
  {% else %}
    <div class="ai-hero-slideshow__placeholder-{{ ai_gen_id }} ai-hero-mobile-{{ ai_gen_id }}">
      {{ 'hero-apparel-2' | placeholder_svg_tag }}
      <div class="ai-hero-slideshow__empty-state-{{ ai_gen_id }}">
        Add a mobile image or video to get started
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_overlay %}
    <div class="ai-hero-slideshow__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-slideshow__content-{{ ai_gen_id }}">
    <div class="ai-hero-slideshow__content-wrapper-{{ ai_gen_id }}">
      {% if block.settings.subtitle != blank %}
        <div class="ai-hero-slideshow__subtitle-{{ ai_gen_id }}">
          {{ block.settings.subtitle }}
        </div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h1 class="ai-hero-slideshow__title-{{ ai_gen_id }}">
          {{ block.settings.title }}
        </h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-hero-slideshow__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        
          href="{{ block.settings.button_link }}"
          class="ai-hero-slideshow__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</hero-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-hero-slideshow__video-{{ ai_gen_id }}');
        if (this.videos.length > 0) {
          this.handleVideoPlayback();
        }
      }

      handleVideoPlayback() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            this.videos.forEach(video => {
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          });
        }, { threshold: 0.5 });

        observer.observe(this);
      }
    }

    if (!customElements.get('hero-slideshow-{{ ai_gen_id }}')) {
      customElements.define('hero-slideshow-{{ ai_gen_id }}', HeroSlideshow{{ ai_gen_id }});
    }
  })();
</script>

