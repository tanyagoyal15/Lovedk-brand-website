{% doc %}
  @prompt
    add a block that has 2 columns - left and right and in each column there are 4 links that are one below the other which basically are things that are present in a footer like terms and conditions, shopping policy, contact us, helpa nd all of that. so what you need to do is that you need to make it entirely cutomizable. so i will add ech one and then the page link will also be editable so i can link the thing to that page. it shoul dnot be button format. just hosul b d liek. text that has gets underlined when i hover over it.also all parts of it should be customizable. as in the padding between two, the color of the tects, the bolding, underlining, all of that, in phone they are all in one like singular column only for some reason. even in phone it hsould be 2 columsn
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-footer-links__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-footer-links__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-links__link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-decoration: {% if block.settings.default_underline %}underline{% else %}none{% endif %};
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-footer-links__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_color }};
    text-decoration: {% if block.settings.hover_underline %}underline{% else %}none{% endif %};
  }

  @media screen and (max-width: 749px) {
    .ai-footer-links__container-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_column_gap }}px;
    }
  }
{% endstyle %}

<footer-links-{{ ai_gen_id }} class="ai-footer-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-links__container-{{ ai_gen_id }}">
    <div class="ai-footer-links__column-{{ ai_gen_id }}">
      {% if block.settings.link_1_text != blank %}
        <a href="{{ block.settings.link_1_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_1_text }}
        </a>
      {% endif %}
      {% if block.settings.link_2_text != blank %}
        <a href="{{ block.settings.link_2_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_2_text }}
        </a>
      {% endif %}
      {% if block.settings.link_3_text != blank %}
        <a href="{{ block.settings.link_3_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_3_text }}
        </a>
      {% endif %}
      {% if block.settings.link_4_text != blank %}
        <a href="{{ block.settings.link_4_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_4_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-footer-links__column-{{ ai_gen_id }}">
      {% if block.settings.link_5_text != blank %}
        <a href="{{ block.settings.link_5_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_5_text }}
        </a>
      {% endif %}
      {% if block.settings.link_6_text != blank %}
        <a href="{{ block.settings.link_6_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_6_text }}
        </a>
      {% endif %}
      {% if block.settings.link_7_text != blank %}
        <a href="{{ block.settings.link_7_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_7_text }}
        </a>
      {% endif %}
      {% if block.settings.link_8_text != blank %}
        <a href="{{ block.settings.link_8_url }}" class="ai-footer-links__link-{{ ai_gen_id }}">
          {{ block.settings.link_8_text }}
        </a>
      {% endif %}
    </div>
  </div>
</footer-links-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterLinks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('.ai-footer-links__link-{{ ai_gen_id }}');
      }
    }

    customElements.define('footer-links-{{ ai_gen_id }}', FooterLinks{{ ai_gen_id }});
  })();
</script>

