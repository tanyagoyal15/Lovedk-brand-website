{% doc %}
  @prompt
    Displays all products saved to the wishlist (reads handles from localStorage 'wishlist' key).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wishlist-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.container_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-wishlist-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: 30px;
  }

  .ai-wishlist-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-wishlist-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-wishlist-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 30px;
  }

  @media screen and (max-width: 749px) {
    .ai-wishlist-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-wishlist-product-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
  }

  .ai-wishlist-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-wishlist-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wishlist-actions-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 10;
  }

  .ai-wishlist-action-btn-{{ ai_gen_id }} {
    width: 36px;
    height: 36px;
    background: {{ block.settings.remove_button_bg }};
    border: 1px solid #000000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
    border-radius: 50%;
    opacity: 0.82;
  }

  .ai-wishlist-action-btn-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-wishlist-action-btn-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    stroke: {{ block.settings.remove_button_color }};
  }

  .ai-wishlist-product-info-{{ ai_gen_id }} {
    padding: 15px;
  }

  .ai-wishlist-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    font-weight: 500;
    font-family: "New York", ui-serif, Georgia, serif;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-wishlist-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-wishlist-product-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-wishlist-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 12px;
    font-weight: 400;
    font-family: "New York", ui-serif, Georgia, serif;
  }

  .ai-wishlist-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size | minus: 2 }}px;
    color: #999999;
    text-decoration: line-through;
    margin-bottom: 4px;
    font-family: "New York", ui-serif, Georgia, serif;
  }


  .ai-wishlist-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
  }

  .ai-wishlist-empty-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    opacity: 0.3;
  }

  .ai-wishlist-empty-title-{{ ai_gen_id }} {
    font-size: 24px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-wishlist-empty-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 25px;
  }

  .ai-wishlist-empty-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-wishlist-empty-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
  }

  .ai-wishlist-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    font-size: 16px;
    color: {{ block.settings.subtitle_color }};
  }
{% endstyle %}

<wishlist-products-{{ ai_gen_id }} class="ai-wishlist-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.show_header %}
    <div class="ai-wishlist-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-wishlist-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-wishlist-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-wishlist-loading-{{ ai_gen_id }}" data-loading>
    Loading your wishlist...
  </div>

  <div class="ai-wishlist-grid-{{ ai_gen_id }}" data-products-grid style="display: none;"></div>

  <div class="ai-wishlist-empty-{{ ai_gen_id }}" data-empty-state style="display: none;">
    <div class="ai-wishlist-empty-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </div>
    <h3 class="ai-wishlist-empty-title-{{ ai_gen_id }}">{{ block.settings.empty_title }}</h3>
    <p class="ai-wishlist-empty-text-{{ ai_gen_id }}">{{ block.settings.empty_text }}</p>
    <a href="{{ block.settings.empty_button_link }}" class="ai-wishlist-empty-button-{{ ai_gen_id }}">
      {{ block.settings.empty_button_text }}
    </a>
  </div>
</wishlist-products-{{ ai_gen_id }}>

<script>
(function() {
  class WishlistProducts{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.loadingEl = this.querySelector('[data-loading]');
      this.gridEl    = this.querySelector('[data-products-grid]');
      this.emptyEl   = this.querySelector('[data-empty-state]');
    }

    connectedCallback() {
      this.loadWishlist();

      /* Re-render if another component updates the wishlist */
      document.addEventListener('wishlist:updated', () => this.loadWishlist());
    }

    loadWishlist() {
      const handles = this.getHandlesFromStorage();
      if (!handles || handles.length === 0) {
        this.showEmptyState();
        return;
      }
      this.showLoading();
      this.fetchProducts(handles);
    }

    getHandlesFromStorage() {
      try {
        const raw = localStorage.getItem('wishlist');
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        /* Guard: only keep string handles, discard any legacy numeric IDs */
        return parsed.filter(item => typeof item === 'string' && isNaN(Number(item)));
      } catch (e) {
        console.error('Error reading wishlist:', e);
        return [];
      }
    }

    async fetchProducts(handles) {
      try {
        const results = await Promise.all(
          handles.map(handle =>
            fetch(`/products/${handle}.js`)
              .then(res => {
                if (!res.ok) throw new Error(`Product not found: ${handle}`);
                return res.json();
              })
              .catch(() => null) /* skip unavailable products gracefully */
          )
        );

        const products = results.filter(Boolean);

        if (products.length === 0) {
          this.showEmptyState();
        } else {
          this.renderProducts(products);
        }
      } catch (error) {
        console.error('Error fetching wishlist products:', error);
        this.showEmptyState();
      }
    }

    renderProducts(products) {
      this.loadingEl.style.display = 'none';
      this.gridEl.style.display    = 'grid';
      this.emptyEl.style.display   = 'none';

      this.gridEl.innerHTML = products.map(p => this.createProductCard(p)).join('');

      this.gridEl.querySelectorAll('[data-remove-wishlist]').forEach(btn => {
        btn.addEventListener('click', () => this.removeFromWishlist(btn.dataset.removeWishlist));
      });

      this.gridEl.querySelectorAll('[data-add-to-cart]').forEach(btn => {
        btn.addEventListener('click', () => this.addToCart(btn.dataset.addToCart, btn));
      });
    }

    createProductCard(product) {
      const variant      = product.variants?.[0];
      const price        = variant ? parseFloat(variant.price) : 0;
      const comparePrice = variant ? parseFloat(variant.compare_at_price) : 0;
      const hasDiscount  = comparePrice && comparePrice > price;
      const imageUrl     = product.featured_image || '';

      const priceHtml = hasDiscount
        ? `<div class="ai-wishlist-compare-price-{{ ai_gen_id }}">${this.formatMoney(comparePrice)}</div>
           <div class="ai-wishlist-product-price-{{ ai_gen_id }}">${this.formatMoney(price)}</div>`
        : `<div class="ai-wishlist-product-price-{{ ai_gen_id }}">${this.formatMoney(price)}</div>`;

      return `
        <div class="ai-wishlist-product-{{ ai_gen_id }}">
          <div class="ai-wishlist-image-wrapper-{{ ai_gen_id }}">
            ${imageUrl
              ? `<img src="${imageUrl}" alt="${this.escapeHtml(product.title)}" class="ai-wishlist-image-{{ ai_gen_id }}" loading="lazy">`
              : ''
            }
            <div class="ai-wishlist-actions-{{ ai_gen_id }}">
              <button
                class="ai-wishlist-action-btn-{{ ai_gen_id }}"
                data-remove-wishlist="${product.handle}"
                aria-label="Remove from wishlist"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
                </svg>
              </button>
              <button
                class="ai-wishlist-action-btn-{{ ai_gen_id }}"
                data-add-to-cart="${variant?.id ?? ''}"
                aria-label="Add to bag"
                ${!variant?.id ? 'disabled' : ''}
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="ai-wishlist-product-info-{{ ai_gen_id }}">
            <h3 class="ai-wishlist-product-title-{{ ai_gen_id }}">
              <a href="/products/${product.handle}">${this.escapeHtml(product.title)}</a>
            </h3>
            ${priceHtml}
          </div>
        </div>
      `;
    }

    removeFromWishlist(handle) {
      let wishlist = this.getHandlesFromStorage();
      wishlist     = wishlist.filter(h => h !== handle);

      try {
        localStorage.setItem('wishlist', JSON.stringify(wishlist));
        document.dispatchEvent(new CustomEvent('wishlist:updated', { detail: { count: wishlist.length } }));

        if (wishlist.length === 0) {
          this.showEmptyState();
        } else {
          this.fetchProducts(wishlist).then(/* already handles render */);
          /* Re-fetch fresh so counts stay accurate */
          this.loadWishlist();
        }
      } catch (e) {
        console.error('Error updating wishlist:', e);
      }
    }

    async addToCart(variantId, btn) {
      if (!variantId) return;
      try {
        btn.style.opacity = '0.5';
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        });
        if (res.ok) {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>`;
          btn.style.opacity = '0.82';
          document.dispatchEvent(new CustomEvent('cart:updated'));
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        } else {
          btn.style.opacity = '0.82';
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
        btn.style.opacity = '0.82';
      }
    }

    showLoading() {
      this.loadingEl.style.display = 'block';
      this.gridEl.style.display    = 'none';
      this.emptyEl.style.display   = 'none';
    }

    showEmptyState() {
      this.loadingEl.style.display = 'none';
      this.gridEl.style.display    = 'none';
      this.emptyEl.style.display   = 'block';
    }

    /* Prices from /products/{handle}.js are in paise (120000 = ₹1,200.00) */
    formatMoney(amount) {
      if (!amount) return '₹0.00';
      return new Intl.NumberFormat('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(parseFloat(amount) / 100);
    }

    escapeHtml(text) {
      const d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }
  }

  customElements.define('wishlist-products-{{ ai_gen_id }}', WishlistProducts{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Wishlist products",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "checkbox", "id": "show_header", "label": "Show header", "default": true },
    { "type": "text", "id": "title", "label": "Title", "default": "My Wishlist" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Your saved items" },
    { "type": "select", "id": "header_alignment", "label": "Header alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "center" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 20, "max": 50, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "container_padding", "label": "Container padding", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 10, "max": 40, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Product card" },
    { "type": "range", "id": "product_title_size", "label": "Product title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_border_radius", "label": "Card border radius", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "add_to_cart_text", "label": "Add to cart text", "default": "Add to Cart" },
    { "type": "range", "id": "button_text_size", "label": "Button text size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "button_border_radius", "label": "Button border radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 4 },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_title", "label": "Empty title", "default": "Your wishlist is empty" },
    { "type": "text", "id": "empty_text", "label": "Empty text", "default": "Start adding products you love to your wishlist" },
    { "type": "text", "id": "empty_button_text", "label": "Empty button text", "default": "Continue Shopping" },
    { "type": "url", "id": "empty_button_link", "label": "Empty button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Title", "default": "#000000" },
    { "type": "color", "id": "subtitle_color", "label": "Subtitle", "default": "#666666" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border_color", "label": "Card border", "default": "#e5e5e5" },
    { "type": "color", "id": "product_title_color", "label": "Product title", "default": "#000000" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#000000" },
    { "type": "color", "id": "link_hover_color", "label": "Link hover", "default": "#000000" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "button_hover_bg", "label": "Button hover background", "default": "#333333" },
    { "type": "color", "id": "remove_button_bg", "label": "Remove button background", "default": "#ffffff" },
    { "type": "color", "id": "remove_button_color", "label": "Remove button icon", "default": "#000000" },
    { "type": "color", "id": "remove_button_hover_bg", "label": "Remove button hover background", "default": "#f5f5f5" }
  ],
  "presets": [{ "name": "Wishlist products" }]
}
{% endschema %}
