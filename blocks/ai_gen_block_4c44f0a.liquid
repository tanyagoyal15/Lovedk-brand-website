    <div class="ai-collection-sidebar-actions-{{ ai_gen_id }}">
      <button class="ai-collection-reset-btn-{{ ai_gen_id }}" data-type="filter">Reset</button>
      <button class="ai-collection-apply-btn-{{ ai_gen_id }}" data-type="filter">Apply</button>
    </div>
  </div>

  <div class="ai-collection-sort-sidebar-{{ ai_gen_id }}">
    <div class="ai-collection-sidebar-header-{{ ai_gen_id }}">
      <h3 class="ai-collection-sidebar-title-{{ ai_gen_id }}">Sort</h3>
      <button class="ai-collection-sidebar-close-{{ ai_gen_id }}" data-sidebar="sort" aria-label="Close sidebar">×</button>
    </div>

    <div class="ai-collection-sidebar-content-{{ ai_gen_id }}">
      <div class="ai-collection-filter-section-{{ ai_gen_id }}">
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="title-asc" id="sort-az-{{ ai_gen_id }}">
          <label for="sort-az-{{ ai_gen_id }}">Alphabetically, A-Z</label>
        </div>
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="title-desc" id="sort-za-{{ ai_gen_id }}">
          <label for="sort-za-{{ ai_gen_id }}">Alphabetically, Z-A</label>
        </div>
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="price-asc" id="sort-price-low-{{ ai_gen_id }}">
          <label for="sort-price-low-{{ ai_gen_id }}">Price, Low to High</label>
        </div>
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="price-desc" id="sort-price-high-{{ ai_gen_id }}">
          <label for="sort-price-high-{{ ai_gen_id }}">Price, High to Low</label>
        </div>
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="created-asc" id="sort-old-{{ ai_gen_id }}">
          <label for="sort-old-{{ ai_gen_id }}">Date, Old to New</label>
        </div>
        <div class="ai-collection-filter-option-{{ ai_gen_id }}">
          <input type="radio" name="sort-{{ ai_gen_id }}" value="created-desc" id="sort-new-{{ ai_gen_id }}">
          <label for="sort-new-{{ ai_gen_id }}">Date, New to Old</label>
        </div>
      </div>
    </div>

    <div class="ai-collection-sidebar-actions-{{ ai_gen_id }}">
      <button class="ai-collection-reset-btn-{{ ai_gen_id }}" data-type="sort">Reset</button>
      <button class="ai-collection-apply-btn-{{ ai_gen_id }}" data-type="sort">Apply</button>
    </div>
  </div>

  <div class="ai-collection-grid-{{ ai_gen_id }}"></div>
  <div class="ai-collection-loading-{{ ai_gen_id }}" style="display: none;">Loading more products...</div>
</collection-template-{{ ai_gen_id }}>

<script>
(function() {
  class CollectionTemplate{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentPage = 1;
      this.loading = false;
      this.hasMore = true;
      this.allProducts = [];
      this.filteredProducts = [];
      this.sortBy = '';
      this.filters = {
        availability: [],
        priceMin: null,
        priceMax: null
      };
    }

    connectedCallback() {
      this.collectionHandle = this.dataset.collectionHandle || '{{ collection.handle }}';
      this.grid = this.querySelector('.ai-collection-grid-{{ ai_gen_id }}');
      this.loadingEl = this.querySelector('.ai-collection-loading-{{ ai_gen_id }}');
      this.filterSidebar = this.querySelector('.ai-collection-sidebar-{{ ai_gen_id }}');
      this.sortSidebar = this.querySelector('.ai-collection-sort-sidebar-{{ ai_gen_id }}');
      this.overlay = this.querySelector('.ai-collection-sidebar-overlay-{{ ai_gen_id }}');
      
      this.setupEventListeners();
      this.loadProducts();
      this.setupInfiniteScroll();
    }

    setupEventListeners() {
      const filterBtn = this.querySelector('.ai-collection-filter-btn-{{ ai_gen_id }}');
      const sortBtn = this.querySelector('.ai-collection-sort-btn-{{ ai_gen_id }}');
      const closeBtns = this.querySelectorAll('.ai-collection-sidebar-close-{{ ai_gen_id }}');
      const applyBtns = this.querySelectorAll('.ai-collection-apply-btn-{{ ai_gen_id }}');
      const resetBtns = this.querySelectorAll('.ai-collection-reset-btn-{{ ai_gen_id }}');

      if (filterBtn) filterBtn.addEventListener('click', () => this.openFilterSidebar());
      if (sortBtn) sortBtn.addEventListener('click', () => this.openSortSidebar());
      
      closeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const sidebarType = btn.dataset.sidebar;
          if (sidebarType === 'filter') {
            this.closeFilterSidebar();
          } else if (sidebarType === 'sort') {
            this.closeSortSidebar();
          }
        });
      });

      if (this.overlay) {
        this.overlay.addEventListener('click', () => {
          this.closeFilterSidebar();
          this.closeSortSidebar();
        });
      }

      applyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.dataset.type;
          if (type === 'filter') {
            this.applyFilters();
          } else if (type === 'sort') {
            this.applySort();
          }
        });
      });

      resetBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.dataset.type;
          if (type === 'filter') {
            this.resetFilters();
          } else if (type === 'sort') {
            this.resetSort();
          }
        });
      });
    }

    openFilterSidebar() {
      if (this.filterSidebar) this.filterSidebar.classList.add('active');
      if (this.overlay) this.overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    closeFilterSidebar() {
      if (this.filterSidebar) this.filterSidebar.classList.remove('active');
      if (this.overlay) this.overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    openSortSidebar() {
      if (this.sortSidebar) this.sortSidebar.classList.add('active');
      if (this.overlay) this.overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    closeSortSidebar() {
      if (this.sortSidebar) this.sortSidebar.classList.remove('active');
      if (this.overlay) this.overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    async loadProducts() {
      if (this.loading || !this.hasMore) return;
      
      this.loading = true;
      if (this.loadingEl) this.loadingEl.style.display = 'block';

      try {
        const response = await fetch(`/collections/${this.collectionHandle}/products.json?page=${this.currentPage}&limit=20`);
        const data = await response.json();
        
        if (data.products && data.products.length > 0) {
          this.allProducts = [...this.allProducts, ...data.products];
          this.filteredProducts = [...this.allProducts];
          this.renderProducts(data.products);
          this.currentPage++;
          
          if (data.products.length < 20) {
            this.hasMore = false;
          }
        } else {
          this.hasMore = false;
        }
      } catch (error) {
        console.error('Error loading products:', error);
      } finally {
        this.loading = false;
        if (this.loadingEl) this.loadingEl.style.display = 'none';
      }
    }

    renderProducts(products) {
      products.forEach(product => {
        const productEl = this.createProductElement(product);
        if (this.grid) this.grid.appendChild(productEl);
      });
    }

    createProductElement(product) {
      const div = document.createElement('div');
      div.className = 'ai-collection-product-{{ ai_gen_id }}';
      
      const price = product.variants[0].price;
      const comparePrice = product.variants[0].compare_at_price;
      
      let imageUrl = '';
      if (product.images && product.images.length > 0) {
        if (typeof product.images[0] === 'string') {
          imageUrl = product.images[0];
        } else if (product.images[0].src) {
          imageUrl = product.images[0].src;
        }
      }

      const formattedPrice = this.formatPrice(price);
      const formattedComparePrice = comparePrice ? this.formatPrice(comparePrice) : null;

      div.innerHTML = `
        <a href="/products/${product.handle}" class="ai-collection-product-image-link-{{ ai_gen_id }}">
          ${imageUrl ? `<img src="${imageUrl}" alt="${this.escapeHtml(product.title)}" class="ai-collection-product-image-{{ ai_gen_id }}" loading="lazy">` : ''}
          <div class="ai-collection-product-actions-{{ ai_gen_id }}">
            <button class="ai-collection-wishlist-btn-{{ ai_gen_id }}" data-product-id="${product.id}" aria-label="Add to wishlist">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <button class="ai-collection-cart-btn-{{ ai_gen_id }}" data-variant-id="${product.variants[0].id}" aria-label="Add to cart">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
          </div>
        </a>
        <div class="ai-collection-product-info-{{ ai_gen_id }}">
          <h3 class="ai-collection-product-title-{{ ai_gen_id }}">
            <a href="/products/${product.handle}">${this.escapeHtml(product.title)}</a>
          </h3>
          <div class="ai-collection-product-price-{{ ai_gen_id }}">
            ${formattedComparePrice ? `<span class="ai-collection-price-compare-{{ ai_gen_id }}">₹${formattedComparePrice}</span>` : ''}
            <span class="ai-collection-price-final-{{ ai_gen_id }}">₹${formattedPrice}</span>
          </div>
        </div>
      `;

      const cartBtn = div.querySelector('.ai-collection-cart-btn-{{ ai_gen_id }}');
      if (cartBtn) {
        cartBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.addToCart(product.variants[0].id);
        });
      }

      const wishlistBtn = div.querySelector('.ai-collection-wishlist-btn-{{ ai_gen_id }}');
      if (wishlistBtn) {
        wishlistBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.addToWishlist(product.id);
        });
      }

      return div;
    }

    formatPrice(priceInCents) {
      const priceValue = parseFloat(priceInCents);
      return priceValue.toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    setupInfiniteScroll() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.loading && this.hasMore) {
            this.loadProducts();
          }
        });
      }, {
        rootMargin: '200px'
      });

      if (this.loadingEl) observer.observe(this.loadingEl);
    }

    applyFilters() {
      const inStockEl = this.querySelector('#in-stock-{{ ai_gen_id }}');
      const outStockEl = this.querySelector('#out-stock-{{ ai_gen_id }}');
      const inStockChecked = inStockEl ? inStockEl.checked : false;
      const outStockChecked = outStockEl ? outStockEl.checked : false;
      
      this.filters.availability = [];
      if (inStockChecked) this.filters.availability.push('in-stock');
      if (outStockChecked) this.filters.availability.push('out-stock');

      const priceMinEl = this.querySelector('#price-min-{{ ai_gen_id }}');
      const priceMaxEl = this.querySelector('#price-max-{{ ai_gen_id }}');
      this.filters.priceMin = priceMinEl ? parseFloat(priceMinEl.value) || null : null;
      this.filters.priceMax = priceMaxEl ? parseFloat(priceMaxEl.value) || null : null;

      this.filterAndSort();
      this.closeFilterSidebar();
    }

    applySort() {
      const sortRadios = this.querySelectorAll('input[name="sort-{{ ai_gen_id }}"]:checked');
      this.sortBy = sortRadios.length > 0 ? sortRadios[0].value : '';

      this.filterAndSort();
      this.closeSortSidebar();
    }

    resetFilters() {
      const inStockEl = this.querySelector('#in-stock-{{ ai_gen_id }}');
      const outStockEl = this.querySelector('#out-stock-{{ ai_gen_id }}');
      const priceMinEl = this.querySelector('#price-min-{{ ai_gen_id }}');
      const priceMaxEl = this.querySelector('#price-max-{{ ai_gen_id }}');
      
      if (inStockEl) inStockEl.checked = false;
      if (outStockEl) outStockEl.checked = false;
      if (priceMinEl) priceMinEl.value = '';
      if (priceMaxEl) priceMaxEl.value = '';
      
      this.filters = {
        availability: [],
        priceMin: null,
        priceMax: null
      };

      this.filterAndSort();
      this.closeFilterSidebar();
    }

    resetSort() {
      this.querySelectorAll('input[name="sort-{{ ai_gen_id }}"]').forEach(radio => radio.checked = false);
      this.sortBy = '';

      this.filterAndSort();
      this.closeSortSidebar();
    }

    filterAndSort() {
      this.filteredProducts = [...this.allProducts];

      if (this.filters.availability.length > 0) {
        this.filteredProducts = this.filteredProducts.filter(product => {
          const isAvailable = product.variants.some(v => v.available);
          if (this.filters.availability.includes('in-stock') && isAvailable) return true;
          if (this.filters.availability.includes('out-stock') && !isAvailable) return true;
          return false;
        });
      }

      if (this.filters.priceMin !== null || this.filters.priceMax !== null) {
        this.filteredProducts = this.filteredProducts.filter(product => {
          const price = parseFloat(product.variants[0].price);
          if (this.filters.priceMin !== null && price < this.filters.priceMin) return false;
          if (this.filters.priceMax !== null && price > this.filters.priceMax) return false;
          return true;
        });
      }

      if (this.sortBy) {
        this.filteredProducts.sort((a, b) => {
          if (this.sortBy === 'title-asc') {
            return a.title.localeCompare(b.title);
          }
          if (this.sortBy === 'title-desc') {
            return b.title.localeCompare(a.title);
          }
          if (this.sortBy === 'price-asc') {
            return parseFloat(a.variants[0].price) - parseFloat(b.variants[0].price);
          }
          if (this.sortBy === 'price-desc') {
            return parseFloat(b.variants[0].price) - parseFloat(a.variants[0].price);
          }
          if (this.sortBy === 'created-asc') {
            return new Date(a.created_at) - new Date(b.created_at);
          }
          if (this.sortBy === 'created-desc') {
            return new Date(b.created_at) - new Date(a.created_at);
          }
          return 0;
        });
      }

      if (this.grid) {
        this.grid.innerHTML = '';
        this.renderProducts(this.filteredProducts);
      }
    }

    async addToCart(variantId) {
      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        });

        if (response.ok) {
          window.location.href = '/cart';
        }
      } catch (error) {
        console.error('Error adding to cart:', error);
      }
    }

    addToWishlist(productId) {
      let wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
      if (!wishlist.includes(productId)) {
        wishlist.push(productId);
        localStorage.setItem('wishlist', JSON.stringify(wishlist));
        alert('Added to wishlist!');
      } else {
        alert('Already in wishlist!');
      }
    }
  }

  customElements.define('collection-template-{{ ai_gen_id }}', CollectionTemplate{{ ai_gen_id }});
})();
</script>

