{% doc %}
  @prompt
    Create a new homepage section called “As Spotted On”.
    
    Goal:
    Make a horizontally scrollable banner/carousel where I can add images of people wearing our jewellery.
    
    Section Requirements:
    - Section heading: “AS SPOTTED ON”
    - Horizontally scrollable on mobile and desktop
    - Show image cards in one row
    - Smooth swipe/scroll behavior on mobile
    - Image-first layout
    - Clean, premium jewellery brand look
    - No clutter
    
    Image Card Requirements:
    - Each card should contain:
      - Image of person wearing jewellery
      - Optional name/text below image
      - Optional short caption below name
    - Images should have consistent size and ratio
    - Use portrait ratio, preferably 4:5
    - Rounded corners optional
    - Equal spacing between cards
    
    Editable Settings:
    Make this section editable from the Shopify theme editor.
    
    I should be able to edit:
    - Section heading text
    - Heading font size
    - Heading font weight
    - Heading alignment
    - Card image size
    - Image corner radius
    - Space between cards
    - Top padding
    - Bottom padding
    - Background color
    - Text color
    - Caption text
    - Number of image cards
    - Image upload for each card
    
    Design Style:
    - Premium but simple
    - Suitable for an affordable jewellery brand
    - Should feel like social proof, not an ad
    - Should look good on mobile first
    - Keep it elegant and minimal
    
    Mobile Requirements:
    - Show 1.3 to 1.5 cards visible at a time
    - Allow horizontal swipe
    - Do not stack vertically
    - Keep heading readable
    - Keep padding balanced
    
    Desktop Requirements:
    - Show 4 to 5 cards visible at a time
    - Allow horizontal scroll if more cards are added
    - Keep cards aligned neatly
    
    Default Content:
    Use placeholder cards with:
    - Image placeholder
    - Text: “Worn by our community”
    - Caption: “Styled with DK jewellery”
    
    Final Result:
    A reusable editable Shopify homepage section named “As Spotted On” that I can customize without a developer. It should help build trust by showing real people wearing our jewellery.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spotted-on-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-spotted-on-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-spotted-on-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
    letter-spacing: 1px;
  }

  .ai-spotted-on-scroll-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-spotted-on-scroll-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-spotted-on-cards-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_spacing }}px;
    padding: 0 20px;
    width: max-content;
  }

  .ai-spotted-on-card-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.card_width_mobile }}px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-spotted-on-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-spotted-on-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-spotted-on-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-spotted-on-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-spotted-on-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.4;
  }

  .ai-spotted-on-caption-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .ai-spotted-on-heading-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-spotted-on-cards-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .ai-spotted-on-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width_desktop }}px;
    }
  }
{% endstyle %}

<as-spotted-on-{{ ai_gen_id }} class="ai-spotted-on-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-spotted-on-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-spotted-on-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-spotted-on-scroll-wrapper-{{ ai_gen_id }}">
      <div class="ai-spotted-on-cards-{{ ai_gen_id }}">
        {% for i in (1..block.settings.number_of_cards) %}
          {% liquid
            assign image_key = 'card_image_' | append: i
            assign name_key = 'card_name_' | append: i
            assign caption_key = 'card_caption_' | append: i
            
            assign card_image = block.settings[image_key]
            assign card_name = block.settings[name_key]
            assign card_caption = block.settings[caption_key]
          %}

          <div class="ai-spotted-on-card-{{ ai_gen_id }}">
            <div class="ai-spotted-on-image-wrapper-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 600 }}"
                  alt="{{ card_name | escape }}"
                  loading="lazy"
                  width="600"
                  height="750"
                  class="ai-spotted-on-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-spotted-on-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if card_name != blank %}
              <p class="ai-spotted-on-name-{{ ai_gen_id }}">{{ card_name }}</p>
            {% endif %}

            {% if card_caption != blank %}
              <p class="ai-spotted-on-caption-{{ ai_gen_id }}">{{ card_caption }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</as-spotted-on-{{ ai_gen_id }}>

<script>
  (function() {
    class AsSpottedOn{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollWrapper = this.querySelector('.ai-spotted-on-scroll-wrapper-{{ ai_gen_id }}');
        this.setupSmoothScroll();
      }

      setupSmoothScroll() {
        if (!this.scrollWrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.scrollWrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          this.scrollWrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.scrollWrapper.offsetLeft;
          scrollLeft = this.scrollWrapper.scrollLeft;
        });

        this.scrollWrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.scrollWrapper.style.cursor = 'grab';
        });

        this.scrollWrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.scrollWrapper.offsetLeft;
          const walk = (x - startX) * 1.5;
          this.scrollWrapper.scrollLeft = scrollLeft - walk;
        });

        this.scrollWrapper.style.cursor = 'grab';
      }
    }

    customElements.define('as-spotted-on-{{ ai_gen_id }}', AsSpottedOn{{ ai_gen_id }});
  })();
</script>

