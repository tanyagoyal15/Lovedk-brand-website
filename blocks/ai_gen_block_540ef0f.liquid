{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-banner__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner__container-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-hero-banner__media-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    display: block;
  }

  .ai-hero-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-hero-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-banner__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
  }
{% endstyle %}

<hero-banner-{{ ai_gen_id }}
  class="ai-hero-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-banner__container-{{ ai_gen_id }}">
    {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank or block.settings.desktop_video != blank or block.settings.mobile_video != blank %}
      {% if block.settings.show_overlay %}
        <div class="ai-hero-banner__overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.desktop_video != blank %}
        <video
          class="ai-hero-banner__media-{{ ai_gen_id }} ai-hero-banner__media--desktop-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
          style="display: block;"
        >
          <source
            src="{{ block.settings.desktop_video }}"
            type="video/mp4"
          >
        </video>
      {% elsif block.settings.desktop_image != blank %}
        <img
          src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
          alt="{{ block.settings.desktop_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.desktop_image.width }}"
          height="{{ block.settings.desktop_image.height }}"
          class="ai-hero-banner__media-{{ ai_gen_id }} ai-hero-banner__media--desktop-{{ ai_gen_id }}"
          style="display: block;"
        >
      {% endif %}

      {% if block.settings.mobile_video != blank %}
        <video
          class="ai-hero-banner__media-{{ ai_gen_id }} ai-hero-banner__media--mobile-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
          style="display: none;"
        >
          <source
            src="{{ block.settings.mobile_video }}"
            type="video/mp4"
          >
        </video>
      {% elsif block.settings.mobile_image != blank %}
        <img
          src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
          alt="{{ block.settings.mobile_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.mobile_image.width }}"
          height="{{ block.settings.mobile_image.height }}"
          class="ai-hero-banner__media-{{ ai_gen_id }} ai-hero-banner__media--mobile-{{ ai_gen_id }}"
          style="display: none;"
        >
      {% endif %}

      {% if block.settings.banner_link != blank %}
        <a
          href="{{ block.settings.banner_link }}"
          class="ai-hero-banner__link-{{ ai_gen_id }}"
          aria-label="Banner link"
        ></a>
      {% endif %}
    {% else %}
      <div class="ai-hero-banner__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-banner__empty-state-{{ ai_gen_id }}">
          Next, add an image or video to your banner
        </div>
      </div>
    {% endif %}
  </div>
</hero-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.handleResponsiveMedia();
        window.addEventListener('resize', () => this.handleResponsiveMedia());
      }

      handleResponsiveMedia() {
        const isMobile = window.innerWidth <= 749;
        const desktopMedia = this.querySelectorAll('.ai-hero-banner__media--desktop-{{ ai_gen_id }}');
        const mobileMedia = this.querySelectorAll('.ai-hero-banner__media--mobile-{{ ai_gen_id }}');

        desktopMedia.forEach((media) => {
          media.style.display = isMobile ? 'none' : 'block';
        });

        mobileMedia.forEach((media) => {
          media.style.display = isMobile ? 'block' : 'none';
        });
      }

      disconnectedCallback() {
        window.removeEventListener('resize', () => this.handleResponsiveMedia());
      }
    }

    customElements.define('hero-banner-{{ ai_gen_id }}', HeroBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hero banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Banner settings"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "video_url",
      "id": "desktop_video",
      "label": "Desktop video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "video_url",
      "id": "mobile_video",
      "label": "Mobile video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}