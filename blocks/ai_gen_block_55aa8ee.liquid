{% doc %}
  Collection products conveyor belt carousel with customisable product cards,
  fonts, sizes, colors for title and both price types on separate lines.
  Includes wishlist and add-to-cart icon buttons on each product image.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  .ai-conv-view-all-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 16px;
  }

  .ai-conv-view-all-{{ ai_gen_id }} a {
    display: inline-block;
    background: transparent;
    border: none;
    padding: 0;
    color: #000000;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-bottom: 1.5px solid #000000;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

  .ai-conv-view-all-{{ ai_gen_id }} a:hover {
    opacity: 0.55;
  }

  .ai-conv-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-conv-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    width: fit-content;
    animation: ai-conv-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-conv-container-{{ ai_gen_id }}:hover {
    animation-play-state: {{ block.settings.pause_on_hover | default: true | if: 'paused', 'running' }};
  }

  .ai-conv-track-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    gap: {{ block.settings.card_spacing }}px;
    padding: 0 {{ block.settings.card_spacing | divided_by: 2 }}px;
  }

  .ai-conv-card-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-conv-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    background-color: #f5f5f5;
    flex-shrink: 0;
    display: block;
  }

  .ai-conv-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-conv-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f0f0f0;
  }

  .ai-conv-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.25;
  }

  .ai-conv-icons-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 2;
  }

  .ai-conv-icon-btn-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    background-color: #ffffff;
    border: 1px solid #000000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0.82;
    flex-shrink: 0;
  }

  .ai-conv-icon-btn-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: #000000;
    fill: none;
  }

  .ai-conv-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-conv-title-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-style: {{ block.settings.title_font.style }};
    font-weight: {{ block.settings.title_font_weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.3;
    text-decoration: none;
    display: block;
  }

  .ai-conv-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-conv-prices-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-conv-compare-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-style: {{ block.settings.price_font.style }};
    font-weight: {{ block.settings.compare_price_font_weight }};
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    opacity: 0.7;
    line-height: 1.2;
  }

  .ai-conv-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font.family }}, {{ block.settings.price_font.fallback_families }};
    font-style: {{ block.settings.price_font.style }};
    font-weight: {{ block.settings.price_font_weight }};
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    line-height: 1.2;
  }

  @keyframes ai-conv-scroll-{{ ai_gen_id }} {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    .ai-conv-card-{{ ai_gen_id }} {
      width: {{ block.settings.card_width | times: 0.75 }}px;
    }
    .ai-conv-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height | times: 0.75 }}px;
    }
  }
{% endstyle %}
<conv-carousel-{{ ai_gen_id }} class="ai-conv-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
    {% assign products = block.settings.collection.products %}
    <div class="ai-conv-container-{{ ai_gen_id }}" role="region" aria-label="Product carousel">

      {%- comment -%} Render track twice for seamless looping {%- endcomment -%}
      {% for pass in (1..2) %}
        <div class="ai-conv-track-{{ ai_gen_id }}">
          {% for product in products limit: block.settings.products_limit %}
            <div class="ai-conv-card-{{ ai_gen_id }}">

              <a href="{{ product.url }}" class="ai-conv-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="{{ block.settings.image_height }}"
                  >
                {% else %}
                  <div class="ai-conv-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if pass == 1 %}
                  <div class="ai-conv-icons-{{ ai_gen_id }}">
                    <button
                      class="ai-conv-icon-btn-{{ ai_gen_id }} ai-conv-wishlist-btn-{{ ai_gen_id }}"
                      aria-label="Add to wishlist"
                      data-product-handle="{{ product.handle }}"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                    <button
                      class="ai-conv-icon-btn-{{ ai_gen_id }} ai-conv-cart-btn-{{ ai_gen_id }}"
                      aria-label="Add to cart"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      onclick="event.preventDefault(); event.stopPropagation();"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <path d="M16 10a4 4 0 0 1-8 0"></path>
                      </svg>
                    </button>
                  </div>
                {% endif %}
              </a>

              <div class="ai-conv-info-{{ ai_gen_id }}">
                <span class="ai-conv-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </span>

                <div class="ai-conv-prices-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-conv-compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                  <span class="ai-conv-price-{{ ai_gen_id }}">
                    {{ product.price | money }}
                  </span>
                </div>
              </div>

            </div>
          {% endfor %}
        </div>
      {% endfor %}

    </div>

    <div class="ai-conv-view-all-{{ ai_gen_id }}">
      <a href="{{ block.settings.collection.url }}">View All</a>
    </div>

  {% else %}
    <div style="text-align:center; padding: 40px 20px; color: #888; font-size: 14px;">
      {% if block.settings.collection == blank %}
        Select a collection to display products here.
      {% else %}
        This collection has no products yet.
      {% endif %}
    </div>
  {% endif %}
</conv-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ConvCarousel{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.cartItems = new Set();
        this.checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;
        this.setupCartButtons();
        this.setupWishlistButtons();
        this.initWishlistState();
        this.fetchCartState();
      }

      async fetchCartState() {
        try {
          const response = await fetch('/cart.js');
          const cart = await response.json();
          this.cartItems = new Set(cart.items.map(item => item.variant_id));
          this.updateCartIcons();
        } catch (e) {
          console.error('Error fetching cart:', e);
        }
      }

      updateCartIcons() {
        this.querySelectorAll('.ai-conv-cart-btn-{{ ai_gen_id }}').forEach(btn => {
          if (this.cartItems.has(parseInt(btn.dataset.variantId))) {
            btn.innerHTML = this.checkIcon;
            btn.setAttribute('aria-label', 'In cart');
          }
        });
      }

      setupCartButtons() {
        this.querySelectorAll('.ai-conv-cart-btn-{{ ai_gen_id }}').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const variantId = parseInt(btn.dataset.variantId);
            if (!variantId || this.cartItems.has(variantId) || btn.disabled) return;
            btn.disabled = true;
            btn.style.opacity = '0.5';
            try {
              const res = await fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: variantId, quantity: 1 })
              });
              if (res.ok) {
                this.cartItems.add(variantId);
                btn.innerHTML = this.checkIcon;
                btn.setAttribute('aria-label', 'In cart');
                btn.style.opacity = '0.82';
                document.dispatchEvent(new CustomEvent('cart:refresh'));
                document.dispatchEvent(new CustomEvent('cart:build'));
              } else {
                btn.disabled = false;
                btn.style.opacity = '0.82';
              }
            } catch (err) {
              console.error('Error adding to cart:', err);
              btn.disabled = false;
              btn.style.opacity = '0.82';
            }
          });
        });
      }

      setupWishlistButtons() {
        this.querySelectorAll('.ai-conv-wishlist-btn-{{ ai_gen_id }}').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const handle = btn.getAttribute('data-product-handle');
            this.handleWishlist(handle, btn);
          });
        });
      }

      handleWishlist(productHandle, button) {
        const STORAGE_KEY = 'wishlist';
        let wishlist = [];
        try {
          wishlist = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (e) {
          wishlist = [];
        }

        const emptyHeart = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;
        const filledHeart = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" style="fill:currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;

        const index = wishlist.indexOf(productHandle);
        if (index === -1) {
          wishlist.push(productHandle);
          button.innerHTML = filledHeart;
          button.setAttribute('aria-label', 'Remove from wishlist');
        } else {
          wishlist.splice(index, 1);
          button.innerHTML = emptyHeart;
          button.setAttribute('aria-label', 'Add to wishlist');
        }

        localStorage.setItem(STORAGE_KEY, JSON.stringify(wishlist));
        document.dispatchEvent(new CustomEvent('wishlist:updated', { detail: { wishlist } }));
      }

      initWishlistState() {
        let wishlist = [];
        try {
          wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]');
        } catch (e) {
          wishlist = [];
        }
        if (!wishlist.length) return;

        const filledHeart = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" style="fill:currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`;

        this.querySelectorAll('.ai-conv-wishlist-btn-{{ ai_gen_id }}').forEach(btn => {
          if (wishlist.includes(btn.getAttribute('data-product-handle'))) {
            btn.innerHTML = filledHeart;
            btn.setAttribute('aria-label', 'Remove from wishlist');
          }
        });
      }
    }

    customElements.define('conv-carousel-{{ ai_gen_id }}', ConvCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product conveyor",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products to show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10
    },
    {
      "type": "header",
      "content": "Card layout"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "card_spacing",
      "label": "Space between cards",
      "min": 5,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card info padding",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
