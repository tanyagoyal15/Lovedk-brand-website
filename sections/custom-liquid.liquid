{% style %}
  .slide-announcement-wrapper-{{ section.id }} {
    --row-height: {{ section.settings.bar_height }}px;
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    height: var(--row-height);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    {% if section.settings.show_bottom_border %}
      border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.1 }};
    {% endif %}
  }

  .slide-announcement-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    height: var(--row-height);
    overflow: hidden;
    padding: 0 15px;
  }

  .slide-announcement-{{ section.id }} ul {
    list-style: none;
    padding: 0;
    margin: 0;
    {% if section.blocks.size > 1 %}
      animation: slideUp-{{ section.id }} {{ section.blocks.size | times: section.settings.animation_speed }}s infinite;
    {% endif %}
  }

  .slide-announcement-{{ section.id }}:hover ul {
    animation-play-state: paused;
  }

  .slide-announcement-{{ section.id }} li {
    height: var(--row-height);
    line-height: var(--row-height);
    font-size: {{ section.settings.font_size_desktop }}px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: {{ section.settings.text_color }};
    text-align: {{ section.settings.text_alignment }};
  }

  /* Automatically generated keyframes based on the number of text blocks */
  {% if section.blocks.size > 1 %}
    @keyframes slideUp-{{ section.id }} {
      {% assign block_count = section.blocks.size %}
      {% assign step = 100.0 | divided_by: block_count %}
      
      {% for block in section.blocks %}
        {% assign start_pause = forloop.index0 | times: step %}
        {% assign end_pause = start_pause | plus: step | minus: 5.0 %}
        
        {{ start_pause }}% { transform: translateY(calc(var(--row-height) * -{{ forloop.index0 }})); }
        {{ end_pause }}% { transform: translateY(calc(var(--row-height) * -{{ forloop.index0 }})); }
      {% endfor %}
      
      100% { transform: translateY(0); }
    }
  {% endif %}

  /* Mobile Responsive Settings */
  @media (max-width: 768px) {
    .slide-announcement-{{ section.id }} li {
      font-size: {{ section.settings.font_size_mobile }}px;
      letter-spacing: 0.08em;
    }
  }
{% endstyle %}

<div class="slide-announcement-wrapper-{{ section.id }}">
  <div class="slide-announcement-{{ section.id }}">
    <ul>
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {% else %}
        <li>Add an announcement block in the editor</li>
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Text Slideshow Bar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show subtle bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Sizing & Spacing"
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar Height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content Max Width",
      "min": 400,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Desktop Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Mobile Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Seconds per slide",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "sec",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping on Orders Over ₹1499"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Slideshow Bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free Shipping on Orders Over ₹1499" } },
        { "type": "announcement", "settings": { "text": "COD available on orders over ₹1500" } },
        { "type": "announcement", "settings": { "text": "Made to order, shipped between 2-14 days" } }
      ]
    }
  ]
}
{% endschema %}